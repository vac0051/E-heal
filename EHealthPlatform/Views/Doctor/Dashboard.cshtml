@model IEnumerable<EHealthPlatform.Models.Appointment>
@{
    ViewData["Title"] = "Doctor Dashboard";
}

<h2 class="mb-4">Today's Appointments</h2>

<div class="list-group">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">@item.Date.ToShortTimeString() - @(item.Patient?.User?.FullName ?? "Unknown")</h5>
                    <small>Status: @item.Status</small>
                </div>
                <a asp-action="AddRecord" asp-route-patientId="@item.PatientId" class="btn btn-sm btn-outline-primary">Add Record</a>
            </div>
        }
    }
    else
    {
        <div class="list-group-item">No appointments scheduled for today.</div>
    }
</div>

<div class="mt-4">
    <a asp-action="MyPatients" class="btn btn-secondary">View All Patients</a>
</div>
