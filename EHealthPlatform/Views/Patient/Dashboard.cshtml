@model IEnumerable<EHealthPlatform.Models.Appointment>
@{
    ViewData["Title"] = "Patient Dashboard";
}

<h2 class="mb-4">My Appointments</h2>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Date</th>
                <th>Doctor</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Date.ToShortDateString() @item.Date.ToShortTimeString()</td>
                        <td>Dr. @(item.Doctor?.User?.FullName ?? "Unknown")</td>
                        <td>
                            <span class="badge @(item.Status == "Scheduled" ? "bg-warning text-dark" : "bg-success")">
                                @item.Status
                            </span>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center">No appointments found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-4">
    <a asp-action="MedicalHistory" class="btn btn-info text-white">View Medical History</a>
    <a asp-action="HospitalizationQueue" class="btn btn-warning text-dark">View Hospitalization Queue</a>
    <a asp-action="BookAppointment" class="btn btn-primary">Book New Appointment</a>
</div>
