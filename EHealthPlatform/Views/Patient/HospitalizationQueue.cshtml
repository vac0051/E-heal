@model IEnumerable<EHealthPlatform.Models.Hospitalization>
@{
    ViewData["Title"] = "Hospitalization Queue";
}

<h2 class="mb-4">My Hospitalization Queue</h2>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Requested Date</th>
                <th>Clinic</th>
                <th>Reason</th>
                <th>Admission Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.RequestedDate.ToShortDateString()</td>
                        <td>@item.Clinic?.Name</td>
                        <td>@item.Reason</td>
                        <td>@(item.AdmissionDate?.ToShortDateString() ?? "Pending")</td>
                        <td>
                            <span class="badge @(item.Status == "InQueue" ? "bg-warning text-dark" : "bg-info")">
                                @item.Status
                            </span>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">No hospitalization requests found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
