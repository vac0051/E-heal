@model IEnumerable<EHealthPlatform.Models.MedicalRecord>
@{
    ViewData["Title"] = "Medical History";
}

<h2>My Medical History</h2>
<hr />

@if (Model != null && Model.Any())
{
    foreach (var record in Model)
    {
        <div class="card mb-3">
            <div class="card-header bg-info text-white">
                <strong>Date:</strong> @record.Date.ToShortDateString() | <strong>Doctor:</strong> Dr. @record.Doctor?.User?.FullName
            </div>
            <div class="card-body">
                <h5 class="card-title">Diagnosis: @record.Diagnosis</h5>
                <p class="card-text"><strong>Treatment:</strong> @record.Treatment</p>

                @if (record.Prescriptions != null && record.Prescriptions.Any())
                {
                    <h6>Prescriptions:</h6>
                    <ul>
                        @foreach(var pres in record.Prescriptions)
                        {
                            <li>@pres.Medication - @pres.Dosage</li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-info">No medical records found.</div>
}

<a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
